{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontier-hourly-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  // Cron only: no public URL, so the dispatch token never sits behind a request handler.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "REPOSITORY": "raybeecham/quantum-research-scout",
    "WORKFLOW_FILE": "hourly-news.yml",
  },
  // Same slots as the workflow's own schedule; the due gate keeps one collection per hour.
  "triggers": { "crons": ["13,43 * * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true } },
}
